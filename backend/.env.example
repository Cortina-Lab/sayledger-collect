# Copy to backend/.env and fill in. The real .env is git-ignored.
# Key from https://dev.meta.ai (Meta Model API).
META_API_KEY=
# Where book files (one SQLite file per install) are stored. Git-ignored.
SAYLEDGER_DATA=data
# PayPal SANDBOX app (developer.paypal.com -> Apps & Credentials -> Sandbox). Never live keys.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook you add for INVOICING.INVOICE.* -> https://<host>/paypal/webhook
PAYPAL_WEBHOOK_ID=
